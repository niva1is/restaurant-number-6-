# Скопируйте в .env (cp .env.example .env). Файл .env в Git не коммитится.

# ── Сервер ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Разрешённые origin фронтенда через запятую; * — любой (только для разработки)
CORS_ORIGIN=http://localhost:5173
# Адрес фронтенда: из него строится ссылка в QR-коде стола  <PUBLIC_APP_URL>/table/<tableToken>
PUBLIC_APP_URL=http://localhost:5173

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qr_restaurant
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_restaurant?schema=public"

# ── JWT (персонал) ──────────────────────────────────────
# Обязательно замените на длинную случайную строку: openssl rand -hex 32
JWT_SECRET=dev_only_change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ── RabbitMQ ────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Бизнес-настройки ────────────────────────────────────
# Минимальный интервал между вызовами официанта с одного стола, секунд (BE-10)
WAITER_CALL_COOLDOWN_SECONDS=30

# ── Демо-данные (prisma db seed) ────────────────────────
SEED_ADMIN_PASSWORD=admin123
SEED_COOK_PASSWORD=cook123
SEED_WAITER_PASSWORD=waiter123
